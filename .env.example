# ─── Core ─────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE-WITH-STRONG-RANDOM-KEY

# Set false in production
DEBUG=True

# Comma-separated list of allowed hostnames for production
# Example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost,172.15.54.93

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, development only — no DATABASE_URL needed)
# PostgreSQL (production — recommended):
# DATABASE_URL=postgresql://user:password@localhost:5432/fintrack_db

# ─── Cache / Sessions ─────────────────────────────────────────────────────────
# Redis (production — recommended for shared cache and fast sessions):
# REDIS_URL=redis://127.0.0.1:6379/1
# Leave empty to use per-process LocMemCache (development)
REDIS_URL=

# ─── Language & Timezone ──────────────────────────────────────────────────────
LANGUAGE_CODE=uz
TIME_ZONE=Asia/Tashkent

# ─── Currency rates (relative to UZS) ────────────────────────────────────────
RATE_USD=12700
RATE_EUR=13800
RATE_RUB=140

# ─── AI Providers (at least one key needed for AI features) ──────────────────
AI_PROVIDER=auto
# auto: tries providers in order; or set: groq / openai / anthropic / gemini
AI_PROVIDER_ORDER=groq,openai,anthropic,gemini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-001
GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# ─── Security (set all for production) ───────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_LOGIN_USERNAME_MAX=10
RATE_LIMIT_LOGIN_USERNAME_WINDOW=300
# Set true to rate-limit ALL requests (not just login)
RATE_LIMIT_ALL_REQUESTS=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# ─── Idle logout ──────────────────────────────────────────────────────────────
IDLE_LOGOUT_ENABLED=false
IDLE_LOGOUT_SECONDS=900

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=false

# ─── Notification refresh throttle ───────────────────────────────────────────
NOTIFICATION_REFRESH_CACHE_SECONDS=300

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
